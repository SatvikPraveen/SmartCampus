repository-code: "https://github.com/SatvikPraveen/SmartCampus"
license: MIT
version: 2.0.1
date-released: 2026-10-04
keywords:
  - course timetabling
  - graph colouring
  - DSATUR
  - simulated annealing
  - combinatorial optimisation
  - reproducibility
